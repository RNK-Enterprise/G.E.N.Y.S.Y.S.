{
  "name": "rnk-axis",
  "version": "0.1.0",
  "description": "Axis - RNK privacy browser built around Mother Lisa",
  "author": "Asgard Innovations / RNK™",
  "license": "PROPRIETARY",
  "private": true,
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:tauri": "bash scripts/with-webkit-pc.sh tauri dev",
    "dev": "vite",
    "catalog": "node scripts/generate-axis-catalog.mjs",
    "prebuild": "npm run catalog",
    "audit:globals": "node scripts/audit-window-globals.mjs",
    "prebuild:vite": "npm run audit:globals",
    "build:vite": "vite build",
    "build": "bash scripts/with-webkit-pc.sh tauri build",
    "build:debug": "bash scripts/with-webkit-pc.sh tauri build --debug",
    "check:rust": "bash scripts/with-webkit-pc.sh cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "bash scripts/with-webkit-pc.sh tauri",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "playwright test",
    "test:watch": "npm run test -- --watch",
    "verify": "bash scripts/verify.sh",
    "verify:live": "bash scripts/verify-live.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.{js,html,css}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.3",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.3",
    "acorn": "^8.18.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "playwright": "^1.62.1",
    "prettier": "^3.1.1",
    "vite": "^5.0.11"
  },
  "engines": {
    "node": ">=22.20.0",
    "npm": ">=10.0.0"
  }
}
