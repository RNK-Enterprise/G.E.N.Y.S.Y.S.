#!/usr/bin/env bash
# Axis™ — pre-push gate
# Copyright © 2026 Asgard Innovations / RNK™. All Rights Reserved.
#
# Runs `npm run verify` (fail-fast) before any push leaves this machine: global
# audit → jest → playwright → cargo test. A push is refused if any stage fails.
#
# Wired up with:  npm run hooks:install   (sets core.hooksPath=.githooks)
# Opt-out (use sparingly, it is logged):  git push --no-verify
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo "axis pre-push: verifying (audit → unit → e2e → rust, stop at first failure)…"
exec bash "$ROOT/scripts/verify.sh" --fail-fast
